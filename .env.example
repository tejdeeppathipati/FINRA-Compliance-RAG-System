# Copy to .env and fill only the provider key you intend to use.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://finra:finra@localhost:5432/finra_rag
DATABASE_DIRECT_URL=postgresql+psycopg://finra:finra@localhost:5432/finra_rag
OPENAI_API_KEY=
GEMINI_API_KEY=
FINRA_FETCH_CONTACT=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gpt-4.1-mini
GENERATION_PROVIDER=openai
PROMPT_VERSION=finra-grounded-v1
DEFAULT_RETRIEVAL_MODE=hybrid
DEFAULT_TOP_K=5
RRF_K=60
REQUEST_TIMEOUT_SECONDS=30
CORS_ORIGINS=
